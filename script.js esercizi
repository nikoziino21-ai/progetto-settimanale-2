/* VERSIONE AVANZATA — renderProdotti(lista)
   Funzione che, dato un array di prodotti, genera la griglia nel DOM.
   Niente HTML hard-coded per i prodotti: tutto generato dal JavaScript.
*/

/* SCRIVI QUI LA TUA RISposta */
const renderProdotti = function(lista) {
    const container = document.querySelector("#prodotti");
    if (!container) return;
    
    container.innerHTML = "";
    
    lista.forEach(prod => {
        const card = document.createElement("div");
        card.className = "prodotto-card";
        
        let statoBottone = prod.disponibile 
            ? `<button class="btn-carrello">Aggiungi al carrello</button>` 
            : `<button class="btn-carrello" disabled>Esaurito</button>`;
        
        card.innerHTML = `
            <img src="${prod.immagine}" alt="${prod.nome}" width="200">
            <h3>${prod.nome}</h3>
            <p>Categoria: ${prod.categoria}</p>
            <p>Prezzo: ${formattaPrezzo(prod.prezzo)}</p>
            <p>Rating: ${stelline(prod.rating)}</p>
            ${statoBottone}
        `;
        
        container.appendChild(card);
    });
};


/* VERSIONE AVANZATA — Aggiungi al carrello
   Quando si clicca il bottone "Aggiungi al carrello", incrementa il contatore
   nell'header (Carrello (0) → Carrello (1) → ...).
   Per i prodotti esauriti: bottone disabilitato e testo "Esaurito".
   Suggerimento: usa una closure come visto in aula
*/

/* SCRIVI QUI LA TUA RISposta */
const gestoreCarrello = (function() {
    let contatore = 0;
    return function() {
        contatore++;
        console.log(`Carrello (${contatore})`);
    }
})();

document.addEventListener("click", function(e) {
    if (e.target && e.target.classList.contains("btn-carrello") && !e.target.disabled) {
        gestoreCarrello();
    }
});


/* VERSIONE AVANZATA — Ordinamento
   Menu a tendina con: Prezzo crescente, Prezzo decrescente, Rating.
   Suggerimento: per rendere più leggibile la select puoi usare optgroup
*/

/* SCRIVI QUI LA TUA RISposta */
const ordinaProdotti = function(criterio) {
    let copiaProdotti = [...prodotti];
    if (criterio === "crescente") {
        copiaProdotti.sort((a, b) => a.prezzo - b.prezzo);
    } else if (criterio === "decrescente") {
        copiaProdotti.sort((a, b) => b.prezzo - a.prezzo);
    } else if (criterio === "rating") {
        copiaProdotti.sort((a, b) => b.rating - a.rating);
    }
    renderProdotti(copiaProdotti);
};



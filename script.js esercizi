/* VERSIONE AVANZATA — renderProdotti(lista)
   Funzione che, dato un array di prodotti, genera la griglia nel DOM.
   Niente HTML hard-coded per i prodotti: tutto generato dal JavaScript.
*/

/* SCRIVI QUI LA TUA RISPOSTA */
function renderProdotti(lista) {
  const container = document.getElementById("griglia-prodotti");
  if (!container) return;
  container.innerHTML = "";

  lista.forEach(prodotto => {
    const card = document.createElement("div");
    card.className = "prodotto-card";

    card.innerHTML = `
      <div class="prodotto-img-placeholder">${prodotto.nome}</div>
      <div class="prodotto-info">
        <h3>${prodotto.nome}</h3>
        <p class="categoria">${prodotto.categoria}</p>
        <div class="rating">${stelline(prodotto.rating)}</div>
        <p class="prezzo">${formattaPrezzo(prodotto.prezzo)}</p>
        <button class="btn-carrello" ${!prodotto.disponibile ? 'disabled' : ''}>
          ${prodotto.disponibile ? 'Aggiungi al carrello' : 'Esaurito'}
        </button>
      </div>
    `;
    container.appendChild(card);
  });
}


/* VERSIONE AVANZATA — Aggiungi al carrello
   Quando si clicca il bottone "Aggiungi al carrello", incrementa il contatore
   nell'header (Carrello (0) → Carrello (1) → ...).
   Per i prodotti esauriti: bottone disabilitato e testo "Esaurito".
   Suggerimento: usa una closure come visto in aula
*/

/* SCRIVI QUI LA TUA RISPOSTA */
const gestisciCarrello = (() => {
  let conteggio = parseInt(localStorage.getItem("cartCount")) || 0;

  function aggiornaUI() {
    const badgeCarrello = document.getElementById("carrello-counter");
    if (badgeCarrello) {
      badgeCarrello.innerText = `Carrello (${conteggio})`;
    }
    localStorage.setItem("cartCount", conteggio);
  }

  return {
    aggiungi: function() {
      conteggio++;
      aggiornaUI();
    },
    inizializza: function() {
      aggiornaUI();
      document.addEventListener("click", function(e) {
        if (e.target.classList.contains("btn-carrello") && !e.target.disabled) {
          gestisciCarrello.aggiungi();
        }
      });
    }
  };
})();


/* VERSIONE AVANZATA — Ordinamento
   Menu a tendina con: Prezzo crescente, Prezzo decrescente, Rating.
   Suggerimento: per rendere più leggibile la select puoi usare optgroup
*/

/* SCRIVI QUI LA TUA RISPOSTA */
function ordinaProdotti(criterio) {
  let listaOrdinata = [...prodotti];
  if (criterio === "prezzo-crescente") {
    listaOrdinata.sort((a, b) => a.prezzo - b.prezzo);
  } else if (criterio === "prezzo-decrescente") {
    listaOrdinata.sort((a, b) => b.prezzo - a.prezzo);
  } else if (criterio === "rating") {
    listaOrdinata.sort((a, b) => b.rating - a.rating);
  }
  renderProdotti(listaOrdinata);
}



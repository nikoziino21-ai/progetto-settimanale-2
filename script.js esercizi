/* VERSIONE AVANZATA — localStorage
   Il carrello sopravvive al refresh della pagina.
   Concetto da scoprire: localStorage.setItem / localStorage.getItem.
*/

/* SCRIVI QUI LA TUA RISPOSTA */
document.addEventListener("DOMContentLoaded", () => {
  renderProdotti(prodotti);
  gestisciCarrello.inizializza();

  const selectOrdinamento = document.getElementById("ordinamento");
  if (selectOrdinamento) {
    selectOrdinamento.addEventListener("change", (e) => {
      ordinaProdotti(e.target.value);
    });
  }
});




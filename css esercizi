:root {
  --bg-header: #131921;
  --bg-main: #eaeded;
  --accent-yellow: #febd69;
  --text-main: #0f1111;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
}

body {
  background-color: var(--bg-main);
  color: var(--text-main);
}

/* Header */
header {
  background-color: var(--bg-header);
  color: var(--white);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 20px;
}

.logo {
  font-size: 24px;
  font-weight: bold;
  color: var(--accent-yellow);
  letter-spacing: -1px;
}

.search-bar {
  display: flex;
  flex: 1;
  max-width: 600px;
  margin: 0 20px;
}

.search-bar input {
  width: 100%;
  padding: 10px;
  border: none;
  border-radius: 4px 0 0 4px;
  outline: none;
}

.search-bar button {
  background-color: var(--accent-yellow);
  border: none;
  padding: 0 20px;
  border-radius: 0 4px 4px 0;
  cursor: pointer;
  font-weight: bold;
}

.header-links {
  display: flex;
  gap: 20px;
  font-size: 14px;
}

.cart-badge {
  font-weight: bold;
  cursor: pointer;
}

/* Hero Section */
.hero {
  background: linear-gradient(to bottom, #232f3e, #37475a);
  color: var(--white);
  text-align: center;
  padding: 40px 20px 60px 20px;
}

.hero h1 {
  font-size: 32px;
  margin-bottom: 10px;
}

.hero p {
  font-size: 16px;
  color: #cccccc;
}

/* Contenuto Principale */
.container {
  max-width: 1200px;
  margin: -30px auto 40px auto;
  padding: 0 20px;
}

section {
  background: var(--white);
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  margin-bottom: 30px;
}

section h2 {
  margin-bottom: 20px;
  font-size: 22px;
}

/* Filtri e Ordinamento */
.controls {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20px;
}

.controls select {
  padding: 8px;
  border-radius: 4px;
  border: 1px solid #ccc;
}

/* Griglia Prodotti */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 20px;
}

.prodotto-card {
  background: var(--white);
  border: 1px solid #ddd;
  border-radius: 6px;
  padding: 15px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.prodotto-img-placeholder {
  background-color: #e3e6e6;
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  color: #565959;
  border-radius: 4px;
  margin-bottom: 12px;
  text-align: center;
  padding: 0 10px;
}

.prodotto-info h3 {
  font-size: 16px;
  margin-bottom: 6px;
}

.categoria {
  font-size: 12px;
  color: #565959;
  margin-bottom: 6px;
}

.rating {
  color: #ffa41c;
  font-size: 14px;
  margin-bottom: 8px;
}

.prezzo {
  font-size: 18px;
  font-weight: bold;
  color: #0f1111;
  margin-bottom: 12px;
}

.btn-carrello {
  background-color: #ffd814;
  border: 1px solid #fcd200;
  border-radius: 20px;
  padding: 8px;
  width: 100%;
  cursor: pointer;
  font-weight: 500;
  box-shadow: 0 2px 5px rgba(213,217,217,.5);
}

.btn-carrello:hover {
  background-color: #f7ca00;
}

.btn-carrello:disabled {
  background-color: #e3e6e6;
  border-color: #d5d9d9;
  color: #888;
  cursor: not-allowed;
  box-shadow: none;
}

/* Tabella Prodotti Esercizio */
table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
}

th, td {
  border: 1px solid #dddddd;
  text-align: left;
  padding: 10px;
  font-size: 14px;
}

th {
  background-color: #f2f2f2;
}

tr:nth-child(even) {
  background-color: #f9f9f9;
}

/* Footer */
footer {
  background-color: #232f3e;
  color: var(--white);
  text-align: center;
  padding: 20px;
  font-size: 14px;
  margin-top: 40px;
}
